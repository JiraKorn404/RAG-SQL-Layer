# --- PostgreSQL (docker-compose + admin/indexing) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Read-only role used by the agent ---
APP_DB_USER=rag_reader
APP_DB_PASSWORD=change-me-too

# --- Chat history role (reads and inserts chat_memory.chat_turns only) ---
CHAT_DB_USER=rag_memory
CHAT_DB_PASSWORD=change-me-three

# --- Ollama (remote, over Tailscale) ---
OLLAMA_BASE_URL=http://your-ollama-host:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REASONING=true

# --- Agent / SQL execution ---
SQL_ROW_LIMIT=200
SQL_TIMEOUT_MS=15000
MAX_SQL_RETRIES=3

# --- Retrieval ---
VECTOR_COLLECTION=schema_docs
RETRIEVAL_K=6
# Schemas the agent can see (comma-separated; never chat_memory)
DB_SCHEMAS=public,imba,retail

# --- Chat history ---
CHAT_HISTORY_TURNS=5

# --- Query history (similar past queries as SQL examples) ---
QUERY_HISTORY_K=5
QUERY_HISTORY_MIN_SIMILARITY=0.75

# --- Web UI (docker compose only: host port of the Streamlit chat, bound to localhost) ---
WEB_PORT=8501

# --- Langfuse tracing (server: docker compose -f docker-compose.langfuse.yml up -d) ---
# Off by default; runs are traced only when enabled (and the keys are set).
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
# Project keys: the agent sends traces with them, and the server creates the project with them.
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# Langfuse server only (docker-compose.langfuse.yml; not read by the app). Hex values
# (openssl rand -hex 32), since some go into a connection URL.
LANGFUSE_PORT=3000
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=64-hex-chars-change-me
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_PASSWORD=change-me
LANGFUSE_MINIO_PASSWORD=change-me
